# Copy to .env.beta / .env.prod and load with: set -a; source .env.beta; set +a
# Never commit the copies (.gitignore covers them).

STAGE=beta
AWS_REGION=us-east-1
# AWS_PROFILE=my-profile

# From `cdk deploy ... --outputs-file` (ArtifactBucketName / StateTableName).
# Leave empty to keep documents and state on local disk while still calling Bedrock.
S3_ARTIFACT_BUCKET=
DYNAMODB_STATE_TABLE=

# 1 = offline mock mode (no AWS calls, no cost)
AWS_MOCK_MODE=0
