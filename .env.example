# Copy to .env and load with: set -a; source .env; set +a
# Never commit the copy (.gitignore covers it). Set only what your provider needs.

# Provider override (anthropic | bedrock | vertex | foundry | mock)
# SWARM_PROVIDER=anthropic

# Claude API
ANTHROPIC_API_KEY=

# Amazon Bedrock: normal AWS credential chain
# AWS_PROFILE=my-profile
# SWARM_REGION=us-east-1

# Google Vertex AI: run `gcloud auth application-default login`; project and region in config.yaml

# Microsoft Foundry (Azure): API key, or leave empty to use Entra ID (az login)
# AZURE_FOUNDRY_BASE_URL=https://<resource-name>.services.ai.azure.com/anthropic
# AZURE_FOUNDRY_API_KEY=

# 1 = offline mock mode (no cloud calls, no cost)
SWARM_MOCK=0
